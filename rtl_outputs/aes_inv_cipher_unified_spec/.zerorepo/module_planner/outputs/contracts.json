      "main_flow": [
        "Input data mapping to state matrix",
        "InvShiftRows (cyclic right shift)",
        "InvSubBytes (parallel inverse S-box lookup)",
        "AddRoundKey (XOR with round key)",
        "InvMixColumns (GF(2^8) matrix multiplication, except final round)",
        "Output mapping to text_out"
      ],
      "intermediate_objects": [
        {
          "name": "text_in_r",
          "role": "Temporary storage register for input ciphertext during decryption process"
        },
        {
          "name": "sa[0:3][0:3]",
          "role": "4×4 state matrix registers for storing and processing intermediate decryption results"
        },
        {
          "name": "kb[10:0]",
          "role": "Key schedule buffer storing the round keys in reverse order"
        },
        {
          "name": "sa_ark",
          "role": "Result of AddRoundKey XOR operation, used for subsequent InvMixColumns"
        },
        {
          "name": "sa_next",
          "role": "Output of InvMixColumns used as input for the next round"
        }
      ],
