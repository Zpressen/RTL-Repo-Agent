          }
        ],
        "path_annotations": [],
        "registered_paths": [
          "Input data loading: text_in is buffered in text_in_r on clock rising edge, then mapped to state matrix sa while performing initial AddRoundKey.",
          "Round transformation loop: current state matrix sa goes through InvShiftRows, InvSubBytes, AddRoundKey (producing sa_ark), InvMixColumns (producing sa_next); sa_next is registered into sa on clock rising edge.",
          "Key buffer update: received expanded keys (wk3, wk2, wk1, wk0) are stored in kb[10:0] on clock rising edge; selected round key is output to AddRoundKey based on dcnt.",
          "Final output generation: sa_ark result of the last round is mapped to text_out register in column-major order on clock rising edge."
        ],
        "combinational_paths": [
          "InvShiftRows: combinational cyclic right shift on state matrix rows.",
          "InvSubBytes: 16 parallel inverse S-box instances, each combinational from state byte to substituted byte.",
          "AddRoundKey: bitwise XOR of state matrix bytes and round key bytes (combinational).",
          "InvMixColumns: combinational GF(2^8) matrix multiplication on each column using pre-computed functions pmul_e/b/d/9."
        ],
        "special_paths": [],
        "image_grounding": []
