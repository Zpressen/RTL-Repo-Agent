\ No newline at end of file
+endpackage : uart_pkg
+
+
+// ============================================================================
+// UART Package - Shared Type Definitions and Constants
+// ============================================================================
+// Responsibility: Central source for typedefs, enums, and constants
+// Consumers: axi_lite_regs, baud_gen, uart_tx, uart_rx, fifo_sync, testbench
+// ============================================================================
+
+package uart_pkg;
+
+  // --------------------------------------------------------------------------
+  // UART Frame Parameters
+  // --------------------------------------------------------------------------
+  localparam int unsigned UART_DATA_WIDTH = 8;
+  localparam int unsigned UART_STOP_BITS  = 1;
+
+  // Parity configuration enum
+  typedef enum logic [1:0] {
+    PARITY_NONE  = 2'b00,
+    PARITY_EVEN  = 2'b01,
+    PARITY_ODD   = 2'b10
+    // 2'b11 reserved
+  } parity_e;
+
+  // --------------------------------------------------------------------------
+  // FIFO Configuration (shared for TX and RX FIFOs)
+  // --------------------------------------------------------------------------
+  localparam int unsigned FIFO_DEPTH      = 16;
+  localparam int unsigned FIFO_WIDTH      = UART_DATA_WIDTH;
+  localparam int unsigned FIFO_ADDR_WIDTH = $clog2(FIFO_DEPTH);
+
+  // --------------------------------------------------------------------------
+  // Register Address Map (AXI-Lite CSR addresses)
+  // --------------------------------------------------------------------------
+  localparam logic [31:0] REG_CTRL_ADDR    = 32'h00;
+  localparam logic [31:0] REG_STATUS_ADDR  = 32'h04;
+  localparam logic [31:0] REG_TX_DATA_ADDR = 32'h08;
+  localparam logic [31:0] REG_RX_DATA_ADDR = 32'h0C;
+  localparam logic [31:0] REG_BAUD_ADDR    = 32'h10;
+
+  // --------------------------------------------------------------------------
+  // Control Register Field Definitions
+  // --------------------------------------------------------------------------
+  localparam int unsigned CTRL_TX_EN_Pos       = 0;
+  localparam int unsigned CTRL_RX_EN_Pos       = 1;
+  localparam int unsigned CTRL_PARITY_EN_Pos   = 2;
+  localparam int unsigned CTRL_PARITY_TYPE_Pos = 3;
+  localparam int unsigned CTRL_INT_EN_Pos      = 7;
+
+  localparam logic [31:0] CTRL_TX_EN_MASK       = 32'h0000_0001;
+  localparam logic [31:0] CTRL_RX_EN_MASK       = 32'h0000_0002;
+  localparam logic [31:0] CTRL_PARITY_EN_MASK   = 32'h0000_0004;
+  localparam logic [31:0] CTRL_PARITY_TYPE_MASK = 32'h0000_0008;
+  localparam logic [31:0] CTRL_INT_EN_MASK      = 32'h0000_0080;
+
+  // --------------------------------------------------------------------------
+  // Status Register Field Definitions
+  // --------------------------------------------------------------------------
+  localparam int unsigned STATUS_TX_EMPTY_Pos    = 0;
+  localparam int unsigned STATUS_TX_FULL_Pos     = 1;
+  localparam int unsigned STATUS_RX_EMPTY_Pos    = 2;
+  localparam int unsigned STATUS_RX_FULL_Pos     = 3;
+  localparam int unsigned STATUS_RX_DATA_RDY_Pos = 4;
+  localparam int unsigned STATUS_FRAMING_ERR_Pos = 5;
+  localparam int unsigned STATUS_PARITY_ERR_Pos  = 6;
+  localparam int unsigned STATUS_INT_PENDING_Pos = 7;
+
+  localparam logic [31:0] STATUS_TX_EMPTY_MASK    = 32'h0000_0001;
+  localparam logic [31:0] STATUS_TX_FULL_MASK     = 32'h0000_0002;
+  localparam logic [31:0] STATUS_RX_EMPTY_MASK    = 32'h0000_0004;
+  localparam logic [31:0] STATUS_RX_FULL_MASK     = 32'h0000_0008;
+  localparam logic [31:0] STATUS_RX_DATA_RDY_MASK = 32'h0000_0010;
+  localparam logic [31:0] STATUS_FRAMING_ERR_MASK = 32'h0000_0020;
+  localparam logic [31:0] STATUS_PARITY_ERR_MASK  = 32'h0000_0040;
+  localparam logic [31:0] STATUS_INT_PENDING_MASK = 32'h0000_0080;
+
+  // --------------------------------------------------------------------------
+  // Interrupt Status Bits
+  // --------------------------------------------------------------------------
+  localparam logic INT_TX_EMPTY    = 1'b1;
+  localparam logic INT_RX_DATA_RDY = 1'b1;
+  localparam logic INT_ERR         = 1'b1;
+
+  // --------------------------------------------------------------------------
+  // Baud Rate Generator Constants
+  // --------------------------------------------------------------------------
+  localparam int unsigned OVERSAMPLE_RATIO = 16;
+  localparam int unsigned BAUD_TICK_MAX    = 16'd1000;
+
+  // --------------------------------------------------------------------------
+  // FIFO Status Thresholds
+  // --------------------------------------------------------------------------
+  localparam int unsigned FIFO_HALF_FULL    = FIFO_DEPTH / 2;
+  localparam int unsigned FIFO_ALMOST_FULL  = FIFO_DEPTH - 2;
+  localparam int unsigned FIFO_ALMOST_EMPTY = 2;
+
+endpackage : uart_pkg
