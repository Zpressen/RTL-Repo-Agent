{
  "project_name": "axi_uart_periph",
  "top_module": "axi_uart_top",
  "rtl_language": "SystemVerilog (IEEE 1800-2017 synthesizable subset)",
  "toolchain": [
    "verilator",
    "iverilog",
    "vvp",
    "make"
  ],
  "repo_root": "axi_uart_periph/",
  "abstract": "axi_uart_periph is an AXI4-Lite configurable UART peripheral providing TX/RX, programmable baud rate, TX/RX FIFOs, status registers and interrupts for SoC low-speed serial communication and debugging.",
  "clock_reset": {
    "clock_port": "clk",
    "clock_description": "system clock, rising edge triggers all sequential logic",
    "reset_port": "rst_n",
    "reset_polarity": "active-low",
    "reset_release": "sync",
    "reset_value_requirement": "All output ports shall have defined values (no X/Z) during reset; uart_tx=1, irq=0 during reset"
  },
  "default_params": [
    {
      "name": "DATA_W",
      "default": "32",
      "range": "fixed",
      "desc": "AXI data width, fixed at 32"
    },
    {
      "name": "ADDR_W",
      "default": "16",
      "range": "default 16",
      "desc": "AXI address width"
    },
    {
      "name": "FIFO_DEPTH",
      "default": "16",
      "range": "[1, 1024]",
      "desc": "TX/RX FIFO depth"
    },
    {
      "name": "OVERSAMPLE",
      "default": "16",
      "range": "[8, 32]",
      "desc": "RX oversampling ratio"
    },
    {
      "name": "CLK_FREQ_HZ",
      "default": "50_000_000",
      "range": "default",
      "desc": "System clock frequency"
    },
    {
      "name": "BAUD_DEFAULT",
      "default": "115200",
      "range": "default",
      "desc": "Default baud rate"
    }
  ],
  "directories": [],
  "files": {
    "rtl/axi_uart_top.sv": "top integration, port wiring",
    "rtl/modules/axi_lite_regs.sv": "AXI-Lite slave + CSR + register side effects",
    "rtl/modules/baud_gen.sv": "divider to baud_tick and optional oversample tick",
    "rtl/modules/uart_tx.sv": "serialize bytes: idle/start/data/parity/stop FSM",
    "rtl/modules/uart_rx.sv": "detect start, sample bits at midpoints, assemble byte",
    "rtl/modules/fifo_sync.sv": "parameterized sync FIFO for TX/RX",
    "rtl/pkg/uart_pkg.sv": "package with typedefs and constants",
    "tb/axi_uart_tb.sv": "testbench with drivers and checks",
    "tb/models/uart_ref.py": "UART reference model",
    "scripts/run_sim.sh": "simulation run script",
    "scripts/lint.sh": "lint run script",
    "Makefile": "build entry point",
    "README.md": "project documentation"
  },
  "build_entry": "make sim",
  "run_entry": "vvp sim.out",
  "glossary": [],
  "goals": [
    {
      "id": "G1",
      "description": "Implement 8N1 UART (8 data bits, no parity, 1 stop bit) with optional parity (configurable switch)"
    },
    {
      "id": "G2",
      "description": "Provide AXI-Lite CSR (register read/write, status query, clear interrupts)"
    },
    {
      "id": "G3",
      "description": "Support programmable baud rate (divider) with runtime baud rate change"
    },
    {
      "id": "G4",
      "description": "Provide TX/RX FIFO (parameterized depth) with corresponding status/interrupts"
    },
    {
      "id": "G5",
      "description": "Provide minimum usable testbench covering basic TX/RX, register access, interrupts and boundary scenarios"
    }
  ],
  "constraints": [
    {
      "key": "single_clock_domain",
      "value": "All logic operates in clk domain; no CDC required",
      "source_section": "Section 0, 2.2 NG4"
    },
    {
      "key": "axi_single_outstanding",
      "value": "Only single outstanding read/write transactions supported",
      "source_section": "Section 5.3"
    },
    {
      "key": "axi_word_aligned",
      "value": "Only word-aligned addresses supported; misaligned returns SLVERR",
      "source_section": "Section 5.3"
    },
    {
      "key": "no_latch_inference",
      "value": "Combinational logic must assign default values to all outputs",
      "source_section": "Section 0"
    },
    {
      "key": "no_multi_driver",
      "value": "No multi-driver signals allowed",
      "source_section": "Section 0"
    },
    {
      "key": "reset_output_defined",
      "value": "All outputs must have defined values during reset (no X/Z)",
      "source_section": "Section 5.1"
    },
    {
      "key": "uart_tx_reset_idle",
      "value": "uart_tx must be 1 during reset and idle state",
      "source_section": "Section 5.1"
    },
    {
      "key": "tx_fifo_full_slverr",
      "value": "TXDATA write when FIFO full returns SLVERR",
      "source_section": "Section 5.3"
    },
    {
      "key": "no_axi_burst",
      "value": "No AXI full/burst/out-of-order support",
      "source_section": "Section 2.2 NG1"
    },
    {
      "key": "no_dma",
      "value": "No DMA implementation",
      "source_section": "Section 2.2 NG2"
    },
    {
      "key": "no_multi_channel",
      "value": "Single UART channel only",
      "source_section": "Section 2.2 NG2"
    },
    {
      "key": "no_uvm",
      "value": "No UVM environment required",
      "source_section": "Section 2.2 NG5"
    }
  ],
  "soft_preferences": [
    {
      "key": "naming_ports_snake_case",
      "value": "ports/signals use snake_case",
      "source_section": "Section 0"
    },
    {
      "key": "naming_params_upper_snake",
      "value": "parameters use UPPER_SNAKE_CASE",
      "source_section": "Section 0"
    },
    {
      "key": "seq_logic_always_ff",
      "value": "Sequential logic uses always_ff @(posedge clk)",
      "source_section": "Section 0"
    },
    {
      "key": "comb_logic_always_comb",
      "value": "Combinational logic uses always_comb",
      "source_section": "Section 0"
    },
    {
      "key": "nonblocking_assignment",
      "value": "Sequential registers use non-blocking assignment <=",
      "source_section": "Section 0"
    },
    {
      "key": "default_assignment_comb",
      "value": "Combinational logic must provide default assignments for all outputs",
      "source_section": "Section 0"
    }
  ],
  "top_ports": [
    {
