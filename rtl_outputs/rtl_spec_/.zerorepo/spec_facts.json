    },
    {
      "name": "rst_n",
      "direction": "input",
      "width_expr": "1",
      "domain": "clk",
      "desc": "active-low reset"
    },
    {
      "name": "s_axi_awvalid",
      "direction": "input",
      "width_expr": "1",
      "domain": "clk",
      "desc": "AXI-Lite write addr valid"
    },
    {
      "name": "s_axi_awready",
      "direction": "output",
      "width_expr": "1",
      "domain": "clk",
      "desc": "AXI-Lite write addr ready"
    },
    {
      "name": "s_axi_awaddr",
      "direction": "input",
