  "params": [],
  "protocol_contracts": [],
  "registers": [
    {
      "name": "CTRL",
      "address": "0x00",
      "access": "rw",
      "reset_value": "0x0000_0000",
      "description": "enable, irq enables, parity config",
      "fields": [
        {
          "name": "EN",
          "bit_range": "[0]",
          "access": "rw",
          "reset_value": "0",
          "description": "1=enable UART; 0=TX idle, RX disabled"
        },
        {
          "name": "TX_IRQ_EN",
          "bit_range": "[1]",
          "access": "rw",
          "reset_value": "0",
          "description": "TX interrupt enable"
        },
        {
          "name": "RX_IRQ_EN",
          "bit_range": "[2]",
          "access": "rw",
          "reset_value": "0",
          "description": "RX interrupt enable"
        },
        {
          "name": "ERR_IRQ_EN",
          "bit_range": "[3]",
          "access": "rw",
          "reset_value": "0",
          "description": "Error interrupt enable"
        },
        {
          "name": "PARITY_EN",
          "bit_range": "[4]",
          "access": "rw",
          "reset_value": "0",
          "description": "Parity enable"
        },
        {
          "name": "PARITY_ODD",
          "bit_range": "[5]",
          "access": "rw",
          "reset_value": "0",
          "description": "Parity type: 1=odd, 0=even"
        }
      ],
      "side_effects": "none"
    },
    {
      "name": "BAUD",
      "address": "0x04",
      "access": "rw",
      "reset_value": "BAUD_DEFAULT",
      "description": "baud divider",
      "fields": [
        {
          "name": "DIVIDER",
          "bit_range": "[15:0]",
          "access": "rw",
          "reset_value": "BAUD_DEFAULT",
          "description": "Baud rate divider"
        }
      ],
      "side_effects": "new baud rate takes effect for subsequent frames"
    },
    {
      "name": "STAT",
      "address": "0x08",
      "access": "ro",
      "reset_value": "0x0000_0000",
      "description": "fifo status, busy flags, error flags",
      "fields": [
        {
          "name": "TX_FULL",
          "bit_range": "[0]",
          "access": "ro",
          "reset_value": "-",
          "description": "TX FIFO full flag"
        },
        {
          "name": "TX_EMPTY",
          "bit_range": "[1]",
          "access": "ro",
          "reset_value": "-",
          "description": "TX FIFO empty flag"
        },
        {
          "name": "RX_FULL",
          "bit_range": "[2]",
          "access": "ro",
          "reset_value": "-",
          "description": "RX FIFO full flag"
        },
        {
          "name": "RX_EMPTY",
          "bit_range": "[3]",
          "access": "ro",
          "reset_value": "-",
          "description": "RX FIFO empty flag"
        },
        {
          "name": "TX_BUSY",
          "bit_range": "[4]",
          "access": "ro",
          "reset_value": "-",
          "description": "TX busy flag"
        },
        {
          "name": "FRAMING_ERR",
          "bit_range": "[8]",
          "access": "ro",
          "reset_value": "-",
          "description": "Framing error flag"
        },
        {
          "name": "RX_OVERRUN",
          "bit_range": "[9]",
          "access": "ro",
          "reset_value": "-",
          "description": "RX overrun flag"
        }
      ],
      "side_effects": "none"
    },
    {
      "name": "TXDATA",
      "address": "0x0C",
      "access": "wo",
      "reset_value": "-",
      "description": "write byte to TX FIFO",
      "fields": [
        {
          "name": "DATA",
          "bit_range": "[7:0]",
          "access": "wo",
          "reset_value": "-",
          "description": "Byte to transmit"
        }
      ],
      "side_effects": "enqueues byte to TX FIFO if not full; returns SLVERR if full"
    },
    {
      "name": "RXDATA",
      "address": "0x10",
      "access": "ro",
      "reset_value": "-",
      "description": "read byte from RX FIFO",
      "fields": [
        {
          "name": "DATA",
          "bit_range": "[7:0]",
          "access": "ro",
          "reset_value": "-",
          "description": "Received byte"
        }
      ],
      "side_effects": "pops byte from RX FIFO on read"
    },
    {
      "name": "IRQ_STAT",
      "address": "0x14",
      "access": "rw1c",
      "reset_value": "0x0",
      "description": "irq status (write-1-clear)",
      "fields": [
        {
          "name": "FRAMING_ERR",
          "bit_range": "[0]",
          "access": "rw1c",
          "reset_value": "0",
          "description": "Framing error status, write-1-clear"
        },
        {
          "name": "RX_OVERRUN",
          "bit_range": "[1]",
          "access": "rw1c",
          "reset_value": "0",
          "description": "RX overrun status, write-1-clear"
        }
      ],
      "side_effects": "writing 1 clears corresponding error flag"
    }
  ],
  "functional_requirements": [
    {
      "id": "REQ-001",
      "priority": "must",
      "statement": "When rst_n==0, the design shall reset all CSRs to their reset values and drive uart_tx=1, irq=0",
      "corner": "Reset release is synchronous",
      "verify": "SIM(TEST-001), FORMAL(PROP-001)"
    },
    {
      "id": "REQ-002",
      "priority": "must",
      "statement": "When SW writes TXDATA and TX FIFO is not full, the byte shall be enqueued and eventually transmitted on uart_tx",
      "corner": "TX FIFO full returns SLVERR",
      "verify": "SIM(TEST-010), SIM(TEST-011)"
    },
    {
      "id": "REQ-003",
      "priority": "must",
      "statement": "When a valid UART frame is received, the byte shall be pushed into RX FIFO. If RX FIFO is full, set RX_OVERRUN and drop the incoming byte",
      "corner": "RX FIFO full causes overrun",
      "verify": "SIM(TEST-020), SIM(TEST-022)"
    },
    {
      "id": "REQ-004",
      "priority": "should",
      "statement": "irq shall assert whenever an enabled interrupt condition is true and remain asserted until the condition is cleared",
      "corner": "Level-triggered interrupt",
      "verify": "SIM(TEST-030), FORMAL(PROP-010)"
    },
    {
      "id": "REQ-005",
      "priority": "must",
      "statement": "When SW updates BAUD divider, the new baud rate shall take effect for subsequent frames",
      "corner": "Baud update during transmission",
      "verify": "SIM(TEST-040)"
    }
  ],
  "tests": [
    {
      "id": "TEST-001",
      "name": "Reset defaults",
      "purpose": "Verify reset values and reset outputs are not X",
      "steps": [
        "rst_n=0 for 10 cycles",
        "rst_n=1 release",
        "Read CTRL/STAT/IRQ_STAT"
      ],
      "checks": [
        "uart_tx==1",
        "irq==0",
        "CSR at reset values"
      ],
      "pass_condition": "All reset values match spec"
    },
    {
      "id": "TEST-010",
      "name": "TX single byte",
      "purpose": "Verify TXDATA write produces correct TX frame (8N1)",
      "steps": [
        "Write CTRL.EN=1",
        "Write BAUD",
        "Write TXDATA=8'h55",
        "Sample uart_tx"
      ],
      "checks": [
        "Frame is start + 8 data + stop",
        "Data value correct"
      ],
      "pass_condition": "TX frame matches expected 8N1 format"
    },
    {
      "id": "TEST-011",
      "name": "TX FIFO full behavior",
      "purpose": "Verify SLVERR returned when FIFO full",
      "steps": [
        "Fill FIFO",
        "Write TXDATA once more"
      ],
      "checks": [
        "BRESP=SLVERR"
      ],
      "pass_condition": "SLVERR returned on full FIFO write"
    },
    {
      "id": "TEST-020",
      "name": "RX receive + read RXDATA",
      "purpose": "Verify RX frame reception and register read",
      "steps": [
        "Inject byte via uart_drive_rx_byte",
        "Read RXDATA"
      ],
      "checks": [
        "Read byte matches injected"
      ],
      "pass_condition": "RX data matches transmitted"
    },
    {
      "id": "TEST-022",
      "name": "RX overrun",
      "purpose": "Verify overrun behavior when RX FIFO full",
      "steps": [
        "Fill RX FIFO",
        "Inject another byte"
      ],
      "checks": [
        "RX_OVERRUN set",
        "Last byte dropped"
      ],
      "pass_condition": "Overrun flag set, byte dropped"
    },
    {
      "id": "TEST-030",
      "name": "IRQ behaviors",
      "purpose": "Verify irq conditions and clearing",
      "steps": [
        "Trigger interrupt conditions",
        "Clear via IRQ_STAT"
      ],
      "checks": [
        "irq=1 when condition met",
        "irq=0 after clear"
      ],
      "pass_condition": "Interrupt behavior matches spec"
    },
    {
      "id": "TEST-040",
      "name": "BAUD update semantics",
      "purpose": "Verify baud rate update takes effect on next frame",
      "steps": [
        "Transmit frame at baud A",
        "Update BAUD register",
        "Transmit frame at baud B"
      ],
      "checks": [
        "Second frame bit interval matches new divider"
      ],
      "pass_condition": "New baud rate applied to subsequent frames"
    }
  ],
