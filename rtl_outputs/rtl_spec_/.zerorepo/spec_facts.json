  "protocol_contracts_v2": [
    {
      "protocol_name": "AXI4-Lite Slave",
      "rules": [
        {
          "rule_id": "AXI-001",
          "category": "supported_scope",
          "statement": "32-bit data, 16-bit address (parameterizable)",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-002",
          "category": "transaction",
          "statement": "Only single outstanding read/write transactions supported",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-003",
          "category": "timing",
          "statement": "awready/wready/arready may be deasserted when internal busy",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-004",
          "category": "timing",
          "statement": "bvalid returned 1~N cycles after AW+W handshake complete",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-005",
          "category": "error",
          "statement": "Misaligned address returns SLVERR",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-006",
          "category": "side_effect",
          "statement": "TXDATA write enqueues byte if FIFO not full; SLVERR if full",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-007",
          "category": "timing",
          "statement": "rvalid returned 1~N cycles after AR handshake",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-008",
          "category": "error",
          "statement": "Invalid address returns SLVERR on read",
          "source_section": "Section 5.3"
        },
        {
          "rule_id": "AXI-009",
          "category": "transaction",
          "statement": "WSTRB byte enables are honored",
          "source_section": "Section 5.3"
        }
      ],
      "related_code_anchor_ids": [
        "ANCHOR-AXI-001",
        "ANCHOR-AXI-002"
      ]
    },
    {
      "protocol_name": "UART",
      "rules": [
        {
          "rule_id": "UART-001",
          "category": "sampling",
          "statement": "TX idle level = 1",
          "source_section": "Section 5.4"
        },
        {
          "rule_id": "UART-002",
          "category": "sampling",
          "statement": "Frame format: start=0, 8 data bits LSB first, optional parity, 1 stop bit",
          "source_section": "Section 5.4"
        },
        {
          "rule_id": "UART-003",
          "category": "sampling",
          "statement": "RX uses OVERSAMPLE=16 (default) with mid-bit sampling",
          "source_section": "Section 5.4"
        },
        {
          "rule_id": "UART-004",
          "category": "sampling",
          "statement": "baud_tick marks bit time boundaries",
          "source_section": "Section 5.4"
        },
        {
          "rule_id": "UART-005",
          "category": "error",
          "statement": "stop bit != 1 sets FRAMING_ERR",
          "source_section": "Section 5.4"
        },
        {
          "rule_id": "UART-006",
          "category": "error",
          "statement": "RX FIFO full with new byte sets RX_OVERRUN",
          "source_section": "Section 5.4"
        }
      ],
      "related_code_anchor_ids": [
        "ANCHOR-UART-001",
        "ANCHOR-UART-002"
      ]
    }
  ],
  "requirement_specs": [
    {
      "req_id": "REQ-001",
      "priority": "must",
      "statement": "When rst_n==0, the design shall reset all CSRs to their reset values and drive uart_tx=1, irq=0",
      "corner_cases": [
        "Reset release is synchronous"
      ],
      "verify_refs": [
        "TEST-001",
        "PROP-001"
      ],
      "related_code_anchor_ids": [
        "ANCHOR-REQ-001"
      ]
    },
    {
      "req_id": "REQ-002",
      "priority": "must",
      "statement": "When SW writes TXDATA and TX FIFO is not full, the byte shall be enqueued and eventually transmitted on uart_tx",
      "corner_cases": [
        "TX FIFO full returns SLVERR"
      ],
      "verify_refs": [
        "TEST-010",
        "TEST-011"
      ],
      "related_code_anchor_ids": [
        "ANCHOR-REQ-002"
      ]
    },
    {
      "req_id": "REQ-003",
      "priority": "must",
      "statement": "When a valid UART frame is received, the byte shall be pushed into RX FIFO. If RX FIFO is full, set RX_OVERRUN and drop the incoming byte",
      "corner_cases": [
        "RX FIFO full causes overrun"
      ],
      "verify_refs": [
        "TEST-020",
        "TEST-022"
      ],
      "related_code_anchor_ids": [
        "ANCHOR-REQ-003"
      ]
    },
    {
      "req_id": "REQ-004",
      "priority": "should",
      "statement": "irq shall assert whenever an enabled interrupt condition is true and remain asserted until the condition is cleared",
      "corner_cases": [
        "Level-triggered interrupt"
      ],
      "verify_refs": [
        "TEST-030",
        "PROP-010"
      ],
      "related_code_anchor_ids": [
        "ANCHOR-REQ-004"
      ]
    },
    {
      "req_id": "REQ-005",
      "priority": "must",
      "statement": "When SW updates BAUD divider, the new baud rate shall take effect for subsequent frames",
      "corner_cases": [
        "Baud update during transmission"
      ],
      "verify_refs": [
        "TEST-040"
      ],
      "related_code_anchor_ids": [
        "ANCHOR-REQ-005"
      ]
    }
  ],
  "test_specs_v2": [
    {
      "test_id": "TEST-001",
      "purpose": "Verify reset values and reset outputs are not X",
      "steps": [
        "rst_n=0 for 10 cycles",
        "rst_n=1 release",
        "Read CTRL/STAT/IRQ_STAT"
      ],
      "checks": [
        "uart_tx==1",
        "irq==0",
        "CSR at reset values"
      ],
      "driver_tasks": [],
      "related_req_ids": [
        "REQ-001"
      ],
      "related_code_anchor_ids": []
    },
    {
      "test_id": "TEST-010",
      "purpose": "Verify TXDATA write produces correct TX frame (8N1)",
      "steps": [
        "Write CTRL.EN=1",
        "Write BAUD",
        "Write TXDATA=8'h55",
        "Sample uart_tx"
      ],
      "checks": [
        "Frame is start + 8 data + stop",
        "Data value correct"
      ],
      "driver_tasks": [
        "axi_write32"
      ],
      "related_req_ids": [
        "REQ-002"
      ],
      "related_code_anchor_ids": []
    },
    {
      "test_id": "TEST-011",
      "purpose": "Verify SLVERR returned when FIFO full",
      "steps": [
        "Fill FIFO",
        "Write TXDATA once more"
      ],
      "checks": [
        "BRESP=SLVERR"
      ],
      "driver_tasks": [
        "axi_write32"
      ],
      "related_req_ids": [
        "REQ-002"
      ],
      "related_code_anchor_ids": []
    },
    {
      "test_id": "TEST-020",
      "purpose": "Verify RX frame reception and register read",
      "steps": [
        "Inject byte via uart_drive_rx_byte",
        "Read RXDATA"
      ],
      "checks": [
        "Read byte matches injected"
      ],
      "driver_tasks": [
        "uart_drive_rx_byte",
        "axi_read32"
      ],
      "related_req_ids": [
        "REQ-003"
      ],
      "related_code_anchor_ids": []
    },
    {
      "test_id": "TEST-022",
      "purpose": "Verify overrun behavior when RX FIFO full",
      "steps": [
        "Fill RX FIFO",
        "Inject another byte"
      ],
      "checks": [
        "RX_OVERRUN set",
        "Last byte dropped"
      ],
      "driver_tasks": [
        "uart_drive_rx_byte"
      ],
      "related_req_ids": [
        "REQ-003"
      ],
      "related_code_anchor_ids": []
    },
    {
      "test_id": "TEST-030",
      "purpose": "Verify irq conditions and clearing",
      "steps": [
        "Trigger interrupt conditions",
        "Clear via IRQ_STAT"
      ],
      "checks": [
        "irq=1 when condition met",
        "irq=0 after clear"
      ],
      "driver_tasks": [
        "axi_write32",
        "axi_read32"
      ],
      "related_req_ids": [
        "REQ-004"
      ],
      "related_code_anchor_ids": []
    },
    {
      "test_id": "TEST-040",
      "purpose": "Verify baud rate update takes effect on next frame",
      "steps": [
        "Transmit frame at baud A",
        "Update BAUD register",
        "Transmit frame at baud B"
      ],
      "checks": [
        "Second frame bit interval matches new divider"
      ],
      "driver_tasks": [
        "axi_write32"
      ],
      "related_req_ids": [
        "REQ-005"
      ],
      "related_code_anchor_ids": []
    }
  ],
