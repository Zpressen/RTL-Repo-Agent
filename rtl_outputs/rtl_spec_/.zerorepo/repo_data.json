{
  "repository_name": "axi_uart_periph",
  "repository_purpose": "axi_uart_periph 是一个基于 AXI4-Lite 可配置的 UART 外设，提供发送、接收、可编程波特率、TX/RX FIFO、状态寄存器与中断，面向 SoC 低速串口通信与调试场景。",
  "Feature_tree": {
    "functionality": {
      "rtl_top": {
        "rtl__axi_uart_top.sv": [
          "top integration, port wiring"
        ]
      },
      "rtl_modules": {
        "axi_lite_regs.sv": [
          "AXI-Lite slave + CSR + reg side effects"
        ],
        "baud_gen.sv": [
          "divider to baud_tick and oversample tick"
        ],
        "fifo_sync.sv": [
          "parameterized sync FIFO for TX RX"
        ],
        "uart_rx.sv": [
          "detect start, sample bits at midpoints, assemble byte"
        ],
        "uart_tx.sv": [
          "serialize bytes: idle start data parity stop FSM"
        ]
      }
    },
    "data structures": {
      "rtl_pkg": {
        "uart_pkg.sv": [
          "package with typedefs and constants"
        ]
      }
    },
    "workflow": {
      "scripts": {
        "lint.sh": [
          "lint execution script - runs SystemVerlint Verilator lint checks on RTL sources, enforces coding standards before synthesis"
        ],
        "run_sim.sh": [
          "simulation execution script - compiles RTL + testbench, runs functional simulation with UART reference model comparison"
        ]
      },
      "tb": {
        "axi_uart_tb.sv": [
          "top-level testbench"
        ],
        "models__uart_ref.py": [
          "UART reference model - Python golden model for TX RX byte-level behavior, parity calculation, timing verification"
        ]
      }
    },
    "file operation": {
      "repository blueprint": {
        "root files": [
          "Makefile",
          "README.md"
        ],
        "rtl": [
          "axi_uart_top.sv"
        ],
        "rtl/modules": [
          "axi_lite_regs.sv",
          "baud_gen.sv",
          "fifo_sync.sv",
          "uart_rx.sv",
          "uart_tx.sv"
        ],
        "rtl/pkg": [
          "uart_pkg.sv"
        ],
        "scripts": [
          "lint.sh",
          "run_sim.sh"
        ],
        "tb": [
          "axi_uart_tb.sv"
        ],
        "tb/models": [
          "uart_ref.py"
        ]
      }
    }
  },
