{
  "project_name": "axi_uart_periph",
  "top_module": "axi_uart_top",
  "rtl_language": "SystemVerilog-2017",
  "toolchain": [
    "iverilog",
    "verilator",
    "svlint",
    "make"
  ],
  "repo_root": ".",
  "abstract": "axi_uart_periph implements an AXI4-Lite slave UART peripheral with TX/RX FIFOs, CSR regmap, optional parity and interrupt, delivered with a runnable SV testbench and one-command simulation.",
  "clock_reset": {
    "clock_port": "clk",
    "clock_description": "system clock, rising edge triggers all sequential logic",
    "reset_port": "rst_n",
    "reset_polarity": "active-low",
    "reset_release": "sync",
    "reset_value_requirement": "All output ports shall have defined values (no X/Z); uart_tx shall be 1 during reset and after reset when idle; irq shall be 0 during reset; CSRs reset to values per Regmap"
  },
  "default_params": [
    {
      "name": "ADDR_W",
      "default": "16",
      "range": "-",
      "desc": "Address width, covers 64KB address space"
    },
    {
      "name": "DATA_W",
      "default": "32",
      "range": "fixed",
      "desc": "Data width, fixed at 32 for this project"
    },
    {
      "name": "FIFO_DEPTH",
      "default": "16",
      "range": "[1, 1024]",
      "desc": "TX/RX FIFO depth; affects STAT.TX_FULL/TX_EMPTY/RX_FULL/RX_EMPTY and overrun conditions"
    },
    {
      "name": "OVERSAMPLE",
      "default": "16",
      "range": "[8, 32]",
      "desc": "RX oversampling factor; affects RX alignment and sampling tick interval"
    },
    {
      "name": "CLK_FREQ_HZ",
      "default": "50_000_000",
      "range": "-",
      "desc": "System clock frequency for BAUD_DIV calculation"
    },
    {
      "name": "BAUD_DEFAULT",
      "default": "115200",
      "range": "-",
      "desc": "Default baud rate after reset"
    }
  ],
  "directories": [],
  "files": {
    "rtl/axi_uart_top.sv": "Top integration and port wiring only; no complex logic",
    "rtl/modules/axi_lite_regs.sv": "AXI-Lite slave + CSR + register side effects; single source of truth for CSR",
    "rtl/modules/baud_gen.sv": "Divider to baud_tick and optional oversample tick generation",
    "rtl/modules/uart_tx.sv": "Serialize bytes: idle/start/data/parity/stop FSM",
    "rtl/modules/uart_rx.sv": "Detect start bit, sample bits at midpoints, assemble byte",
    "rtl/modules/fifo_sync.sv": "Parameterized synchronous FIFO for TX/RX",
    "rtl/pkg/uart_pkg.sv": "typedef/params/helpers package",
    "tb/axi_uart_tb.sv": "Pure SV testbench; covers TEST-001/010/011/020/030/040",
    "tb/models/uart_ref.py": "Optional golden model",
    "scripts/run_sim.sh": "One-command compile+simulation with PASS/FAIL exit code",
    "scripts/lint.sh": "Optional lint script",
    "Makefile": "Build entry point for sim and lint targets",
    "README.md": "Project documentation"
  },
  "build_entry": "make sim",
  "run_entry": "vvp sim.out",
  "glossary": [
    {
      "term": "baud_tick",
      "definition": "UART '每 1 bit time' 的边界 tick（驱动 TX shift / RX bit 采样推进）"
    },
    {
      "term": "os_tick",
      "definition": "oversample tick（默认 16x；用于 RX 起始位对齐与中点采样）"
    },
    {
      "term": "frame",
      "definition": "UART 帧（start + data + optional parity + stop）"
    }
  ],
  "goals": [
    {
      "id": "G1",
      "description": "实现 AXI4-Lite Slave（32-bit，word-aligned），可访问 CSR 与数据寄存器"
    },
    {
      "id": "G2",
      "description": "实现 UART TX（8N1 默认，可配置 parity），支持可编程波特率"
    }
  ],
  "constraints": [
    {
      "key": "synthesizable_subset_only",
      "value": "SystemVerilog-2017 synthesizable subset only; no dynamic array, class, mailbox in RTL (TB only)",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "always_ff_style",
      "value": "Sequential logic must use always_ff @(posedge clk)",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "always_comb_style",
      "value": "Combinational logic must use always_comb",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "reset_polarity",
      "value": "rst_n is active-low with synchronous release",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "assignment_style",
      "value": "Non-blocking (<=) for sequential; blocking (=) for combinational",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "no_xz_outputs",
      "value": "All outputs must never be X/Z at any time (TB can add X-check)",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "axi_single_outstanding",
      "value": "Single outstanding: max 1 write transaction (AW+W→B) and 1 read transaction (AR→R) at a time",
      "source_section": "5.3 Protocol Contract: AXI4-Lite Slave"
    },
    {
      "key": "ready_backpressure_allowed",
      "value": "*_ready signals may backpressure (pull low) but must not cause deadlock",
      "source_section": "5.3 Protocol Contract: AXI4-Lite Slave"
    },
    {
      "key": "word_aligned_only",
      "value": "Only word-aligned addresses supported (addr[1:0]==0); misaligned access returns SLVERR",
      "source_section": "5.3 Protocol Contract: AXI4-Lite Slave"
    },
    {
      "key": "txdata_uses_lower_byte",
      "value": "TXDATA write uses only WDATA[7:0]",
      "source_section": "5.3 Protocol Contract: AXI4-Lite Slave"
    },
    {
      "key": "tx_fifo_full_slverr",
      "value": "If TX FIFO full on write: no enqueue, BRESP=SLVERR (avoid software infinite wait)",
      "source_section": "5.3 Protocol Contract: AXI4-Lite Slave"
    },
    {
      "key": "rxdata_empty_returns_zero",
      "value": "If RX FIFO empty on read: return RDATA=0 with RRESP=OKAY",
      "source_section": "5.3 Protocol Contract: AXI4-Lite Slave"
    },
    {
      "key": "uart_idle_high",
      "value": "UART TX idle level = 1",
      "source_section": "5.4 Protocol Contract: UART"
    },
    {
      "key": "uart_frame_8n1_default",
      "value": "Default frame: start=0, 8 data bits (LSB first), parity disabled, 1 stop bit",
      "source_section": "5.4 Protocol Contract: UART"
    },
    {
      "key": "uart_tx_reset_high",
      "value": "uart_tx shall be driven to 1 during reset and after reset when idle",
      "source_section": "5.1 Clock & Reset"
    },
    {
      "key": "irq_reset_low",
      "value": "irq shall be 0 during reset",
      "source_section": "5.1 Clock & Reset"
    },
    {
      "key": "single_clock_domain",
      "value": "All logic in single clock domain clk; no multi-clock/CDC",
      "source_section": "2.2 Non-goals"
    },
    {
      "key": "tx_busy_definition",
      "value": "STAT.TX_BUSY=1 when FSM not in IDLE (implementation choice documented)",
      "source_section": "9.2 TX FSM"
    },
    {
      "key": "framing_err_drop_byte",
      "value": "If stop bit != 1: set FRAMING_ERR and drop the byte",
      "source_section": "9.3 RX Sampling"
    },
    {
      "key": "rx_overrun_drop",
      "value": "If RX FIFO full when valid frame arrives: set RX_OVERRUN and drop",
      "source_section": "9.3 RX Sampling"
    },
    {
      "key": "axi_lite_regs_single_source",
      "value": "axi_lite_regs.sv is the single source of truth for CSR and side effects (not分散 in multiple modules)",
      "source_section": "10. Repository Blueprint"
    }
  ],
  "soft_preferences": [
    {
      "key": "iverilog_primary",
      "value": "iverilog is primary tool; verilator optional for lint",
      "source_section": "0. Meta 信息"
    },
    {
      "key": "repo_size_target",
      "value": "≤50 files (this example ~10-15 files)",
