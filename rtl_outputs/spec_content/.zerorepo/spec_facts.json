  "registers": [
    {
      "name": "CTRL",
      "address": "0x00",
      "access": "rw",
      "reset_value": "0x0000_0000",
      "description": "Enable, IRQ enables, parity config",
      "fields": [
        {
          "name": "EN",
          "bit_range": "bit0",
          "access": "rw",
          "reset_value": "0",
          "description": "1=enable UART; 0=TX idle, RX disabled (RX does not sample)"
        },
        {
          "name": "TX_IRQ_EN",
          "bit_range": "bit1",
          "access": "rw",
          "reset_value": "0",
          "description": "TX interrupt enable"
        },
        {
          "name": "PARITY_ODD",
          "bit_range": "bit5",
          "access": "rw",
          "reset_value": "0",
          "description": "0=even parity, 1=odd parity"
        }
      ],
      "side_effects": "-"
    },
    {
      "name": "BAUD",
      "address": "0x04",
      "access": "rw",
      "reset_value": "BAUD_DEFAULT encoded",
      "description": "Baud divider (implementation-defined encoding)",
      "fields": [
        {
          "name": "DIV",
          "bit_range": "bits[15:0]",
          "access": "rw",
          "reset_value": "encoded BAUD_DEFAULT",
          "description": "baud_div = cycles per bit time tick"
        }
      ],
      "side_effects": "baud_tick asserted every baud_div cycles"
    },
    {
      "name": "STAT",
      "address": "0x08",
      "access": "ro",
      "reset_value": "0x0000_0000",
      "description": "FIFO status, busy flags, error flags",
      "fields": [
        {
          "name": "TX_FULL",
          "bit_range": "bit0",
          "access": "ro",
          "reset_value": "-",
          "description": "TX FIFO full flag"
        },
        {
          "name": "TX_EMPTY",
          "bit_range": "bit1",
          "access": "ro",
          "reset_value": "-",
          "description": "TX FIFO empty flag"
        },
        {
          "name": "RX_FULL",
          "bit_range": "bit2",
          "access": "ro",
          "reset_value": "-",
          "description": "RX FIFO full flag"
        }
      ],
      "side_effects": "-"
    },
    {
      "name": "TXDATA",
      "address": "0x0C",
      "access": "wo",
      "reset_value": "-",
      "description": "Write byte to TX FIFO",
      "fields": [],
      "side_effects": "If TX FIFO non-full: push WDATA[7:0]; If full: no push, AXI write response SLVERR"
    },
    {
      "name": "RXDATA",
      "address": "0x10",
      "access": "ro",
      "reset_value": "-",
      "description": "Read byte from RX FIFO (read pops)",
      "fields": [],
      "side_effects": "If RX FIFO non-empty: RDATA[7:0]=byte and pop 1 entry; else: RDATA=0 (no error set)"
    },
    {
      "name": "IRQ_STAT",
      "address": "0x14",
      "access": "rw1c",
      "reset_value": "0x0",
      "description": "IRQ status (write-1-clear for latched errors)",
      "fields": [],
      "side_effects": "Write-1-clear for latched errors"
    }
  ],
  "functional_requirements": [
    {
      "id": "REQ-001",
      "priority": "must",
      "statement": "When rst_n==0, the design shall reset all CSRs to their reset values. uart_tx shall be driven to 1 during reset and after reset when idle. irq shall be 0 during reset.",
      "corner": "Reset assertion and synchronous release",
      "verify": "SIM(TEST-001), FORMAL(PROP-001)"
    }
  ],
  "tests": [
    {
      "id": "TEST-001",
      "name": "",
      "purpose": "验证 reset 后 CSR/输出符合 REQ-001",
      "steps": [
        "rst_n=0 持续 N 个 clk",
        "释放 rst_n=1（同步释放）",
        "读 CTRL/STAT/IRQ_STAT"
      ],
      "checks": [
        "uart_tx==1",
        "irq==0",
        "CSR 为 reset 值"
      ],
      "pass_condition": ""
    }
  ],
