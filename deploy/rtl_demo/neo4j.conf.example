# Independent private graph. Use a newly generated service credential.
server.default_listen_address=127.0.0.1
server.bolt.listen_address=127.0.0.1:7687
server.http.enabled=false
server.https.enabled=false
server.directories.data=/var/lib/rtl-demo-kg/data
server.directories.logs=/var/lib/rtl-demo-kg/logs
server.directories.run=/var/lib/rtl-demo-kg/run
server.memory.heap.initial_size=128m
server.memory.heap.max_size=128m
server.memory.pagecache.size=64m
# Heap is not total JVM memory; verify peak RSS against the process budget.
