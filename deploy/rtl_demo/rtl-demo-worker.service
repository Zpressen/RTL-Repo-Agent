[Unit]
Description=Deep Valley Chip RTL demo worker
After=network-online.target
RequiresMountsFor=/var/lib/rtl-demo/jobs
Wants=network-online.target

[Service]
Type=simple
User=rtl-demo
Group=rtl-demo
WorkingDirectory=/opt/rtl-agent/current
EnvironmentFile=/etc/rtl-demo/environment
ExecStart=/opt/rtl-agent/current/.venv-web/bin/python -m zerorepo.rtl_web.worker --config ${RTL_DEMO_CONFIG}
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rtl-demo
MemoryAccounting=true
MemoryMax=768M
TasksMax=128
CPUAccounting=true
CPUQuota=100%
Slice=rtl-demo-worker.slice

[Install]
WantedBy=multi-user.target
